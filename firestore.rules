rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isKnownAdminEmail() {
      return request.auth != null &&
        request.auth.token.email == "acrmax.dev@gmail.com";
    }

    function hasAdminDoc() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == "admin" &&
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true;
    }

    function isAdmin() {
      return hasAdminDoc() || isKnownAdminEmail();
    }

    match /admins/{adminId} {
      allow read: if request.auth != null && (request.auth.uid == adminId || isAdmin());
      allow write: if isAdmin();
    }

    match /programs/{programId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /questions/{questionId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /selectionRules/{ruleId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    match /candidates/{candidateId} {
      allow create: if true;
      allow update: if true;
      allow read, delete: if isAdmin();
    }

    match /submissions/{submissionId} {
      allow create: if true;
      allow read: if true;
      allow update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
